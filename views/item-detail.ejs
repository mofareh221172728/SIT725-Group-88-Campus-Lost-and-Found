<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Item Detail' }) %>
<body>
<%- include('partials/nav', { active: 'detail' }) %>

<div class="screen-wrap">
  <div class="screen-label">
    <h2>4  Item Detail View</h2>
    <span class="tag">Full details, photos, status, contact/collection info</span>
  </div>
  <div class="device">
    <div class="wf-navbar">
      <div class="wf-logo"><span class="dot"></span> Campus Lost &amp; Found</div>
      <div class="wf-navlinks"><a href="/browse" class="text-decoration-none" style="color:inherit;">← Back to results</a></div>
      <div class="wf-avatar"></div>
    </div>
    <div class="p-4">
      <div class="row g-4">
        <div class="col-lg-6">
          <div class="ph" style="height:320px; border-radius:6px;">Primary photo</div>
          <div class="d-flex gap-2 mt-2">
            <div class="ph" style="width:70px; height:70px; border-radius:4px;">2</div>
            <div class="ph" style="width:70px; height:70px; border-radius:4px;">3</div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge-wf badge-active">Found</span>
            <span class="badge-wf badge-active">Active</span>
          </div>
          <div class="lorem-line w-80" style="height:18px;"></div>
          <div class="lorem-line w-40" style="margin-top:10px;"></div>

          <div class="row mt-3 g-2 mono" style="font-size:.75rem; color:#5b5f66;">
            <div class="col-5">Category</div><div class="col-7 fw-bold text-dark">Electronics</div>
            <div class="col-5">Location found</div><div class="col-7 fw-bold text-dark">Building LC, Level 2</div>
            <div class="col-5">Date found</div><div class="col-7 fw-bold text-dark">29 Aug 2026</div>
            <div class="col-5">Date reported</div><div class="col-7 fw-bold text-dark">30 Aug 2026</div>
          </div>

          <div class="box p-3 mt-3" style="border-radius:4px;">
            <div class="lorem-line w-80"></div>
            <div class="lorem-line w-60"></div>
          </div>

          <div class="box-strong p-3 mt-3" style="border-radius:4px;">
            <div class="kicker mono">Collection instructions</div>
            <div class="lorem-line w-60" style="height:12px;"></div>
            <a href="mailto:reporter@deakin.edu.au" class="btn-wf-strong text-center d-block mt-2">Contact reporter →</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footnote">Purpose: single source of truth for one report (FR-ID-01–04). Status badge reflects Active/Returned/Claimed; contact panel shows email or drop-off location per FR-ID-04.</div>
</div>

<%- include('partials/footer') %>
</body>
</html>
