<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Create Report' }) %>
<body>
<%- include('partials/nav', { active: 'create' }) %>

<div class="screen-wrap">
  <div class="screen-label">
    <h2>3 — Create Report View</h2>
    <span class="tag">Toggle: I Lost Something / I Found Something</span>
  </div>
  <div class="device">
    <div class="wf-navbar">
      <div class="wf-logo"><span class="dot"></span> Campus Lost &amp; Found</div>
      <div class="wf-navlinks"><a href="/browse" class="text-decoration-none" style="color:inherit;">← Back to Browse</a></div>
      <div class="wf-avatar"></div>
    </div>
    <div class="p-4">
      <div class="d-flex justify-content-center mb-4" data-toggle-group="report-type">
        <div class="toggle-wf">
          <button type="button" class="toggle-btn" data-toggle-option="lost">I Lost Something</button>
          <button type="button" class="toggle-btn active" data-toggle-option="found">I Found Something</button>
        </div>
      </div>

      <form class="row justify-content-center" id="report-form"></form>
        <div class="col-lg-7">
          <div class="annot mb-3">The toggle above actually swaps the fields below between Lost-item and Found-item mode (US-01–US-05).</div>

          <!-- FOUND ITEM FIELDS -->
          <div class="row g-3" id="panel-found">
            <div class="col-12 field-wf">
              <label for="f-title">Item title</label>
              <input id="f-title" name="title" type="text" class="input-wf-real" placeholder="e.g. Black Sony headphones">
            </div>
            <div class="col-6 field-wf">
              <label for="f-category">Category</label>
              <select id="f-category" name="category" class="select-wf">
                <option>Electronics</option>
                <option>Keys</option>
                <option>Bags</option>
                <option>Wallets / Cards</option>
                <option>Clothing</option>
                <option>Other</option>
              </select>
            </div>
            <div class="col-6 field-wf">
              <label for="f-date">Date found</label>
              <input id="f-date" name="dateFound" type="date" class="input-wf-real">
            </div>
            <div class="col-12 field-wf">
              <label for="f-location">Discovery location — campus / building / room</label>
              <input id="f-location" name="location" type="text" class="input-wf-real" placeholder="Waurn Ponds · Building LC · Level 2">
            </div>
            <div class="col-12 field-wf">
              <label for="f-desc">Description</label>
              <textarea id="f-desc" name="description" class="input-wf-real" rows="3" placeholder="Short context: what was found and where…"></textarea>
            </div>
            <div class="col-12 field-wf">
              <label>Photos (max 3)</label>
              <div class="d-flex gap-2">
                <button type="button" class="ph" style="width:88px; height:88px; border-radius:4px; border:1px dashed var(--wf-line); cursor:pointer;">+ Add</button>
                <div class="ph" style="width:88px; height:88px; border-radius:4px; opacity:.5;">empty</div>
                <div class="ph" style="width:88px; height:88px; border-radius:4px; opacity:.5;">empty</div>
              </div>
            </div>
            <div class="col-12 field-wf">
              <label>Collection method</label>
              <div class="d-flex gap-2" data-toggle-group="collection-method">
                <button type="button" class="chip-btn active" data-toggle-option="dropoff">Drop at Security / Student Central</button>
                <button type="button" class="chip-btn" data-toggle-option="email">Share my Deakin email</button>
              </div>
            </div>
          </div>

          <!-- LOST ITEM FIELDS -->
          <div class="row g-3 d-none" id="panel-lost">
            <div class="col-12 field-wf">
              <label for="l-title">Item title</label>
              <input id="l-title" name="title" type="text" class="input-wf-real" placeholder="e.g. Blue Nike water bottle">
            </div>
            <div class="col-6 field-wf">
              <label for="l-category">Category</label>
              <select id="l-category" name="category" class="select-wf">
                <option>Electronics</option>
                <option>Keys</option>
                <option>Bags</option>
                <option>Wallets / Cards</option>
                <option>Clothing</option>
                <option>Other</option>
              </select>
            </div>
            <div class="col-6 field-wf">
              <label for="l-date">Date lost</label>
              <input id="l-date" name="dateLost" type="date" class="input-wf-real">
            </div>
            <div class="col-12 field-wf">
              <label for="l-lastseen">Last-seen location — campus / building / room</label>
              <input id="l-lastseen" name="lastSeen" type="text" class="input-wf-real" placeholder="Waurn Ponds · Library · Level 1">
            </div>
            <div class="col-12 field-wf">
              <label for="l-desc">Description</label>
              <textarea id="l-desc" name="description" class="input-wf-real" rows="3" placeholder="What it looks like, any identifying details…"></textarea>
            </div>
            
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/browse" class="btn-wf">Cancel</a>
            <button type="submit" class="btn-wf-strong" form="report-form">Submit Report</button>
          </div>
        </div>
      </form>
    </div>
  </div>
  <div class="footnote">Purpose: single unified form (US-01–US-05). Toggle swaps field set between Lost and Found without navigating away.</div>
</div>

<%- include('partials/footer') %>
</body>
</html>
